{
  "expo": {
    "name": "I-Saraya Delivery",
    "slug": "i-saraya-delivery",
    "extra": {
      "googlePlacesApiKey": "api-key"
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "isaraya",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.isaraya.delivery"
    },
    "android": {
      "package": "com.isaraya.delivery",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "isaraya.com",
              "pathPrefix": "/payment"
            },
            {
              "scheme": "isaraya"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-maps"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
